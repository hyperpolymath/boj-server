-- SPDX-License-Identifier: MPL-2.0
-- Idris2 package file for the BoJ Server ABI layer.

package boj

authors    = "Jonathan D.A. Jewell"
version    = 0.1.0
license    = "MPL-2.0"
brief      = "Formally verified cartridge catalogue for the Bundle of Joy server"
readme     = "../../README.adoc"

sourcedir  = "."

modules    = Boj.Protocol
           , Boj.Domain
           , Boj.Catalogue
           , Boj.CartridgeData
           , Boj.Menu
           , Boj.Federation
           , Boj.Guardian
           , Boj.Safety
           , Boj.SafetyLemmas
           , Boj.SafeHTTP
           , Boj.SafePromptInjection
           , Boj.SafeCORS
           , Boj.SafeAPIKey
           , Boj.CredentialIsolation
           , Boj.SafeWebSocket
           , Boj.CartridgeDispatch
           , Boj.APIContractCoverage

depends    = base
           , contrib
