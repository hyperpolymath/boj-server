# SPDX-License-Identifier: PMPL-1.0-or-later
# Bundle of Joy Server Container Image
#
# Multi-stage build:
#   Stage 1 (zig-builder)  — builds boj-invoke CLI + all cartridge .so files
#   Stage 2 (mix-builder)  — compiles Elixir release (bundles ERTS)
#   Stage 3 (runtime)      — minimal image: Elixir release + boj-invoke + .so files
#
# Build with Podman:
#   podman build -t boj-server:latest -f container/Containerfile .
#
# Run:
#   podman run -p 7700:7700 boj-server:latest

# ============================================================================
# Stage 1: Zig FFI Builder
# ============================================================================

FROM cgr.dev/chainguard/wolfi-base:latest AS zig-builder

RUN apk add --no-cache zig build-base

WORKDIR /build

# Copy Zig source and cartridge FFI sources
COPY ffi/zig/ ffi/zig/
COPY cartridges/ cartridges/

# Build boj-invoke CLI (x86_64-linux-gnu target so it uses DlDynLib/real dlopen)
RUN cd ffi/zig && zig build invoke -Doptimize=ReleaseFast

# Build all cartridge .so files that have a build.zig
RUN for ffi_dir in /build/cartridges/*/ffi; do \
      cart="$(basename "$(dirname "$ffi_dir")")" && \
      if [ -f "$ffi_dir/build.zig" ]; then \
        echo "Building ${cart}..." && \
        cd "$ffi_dir" && \
        zig build -Doptimize=ReleaseFast 2>/dev/null || \
          echo "WARN: ${cart} FFI skipped (non-fatal)"; \
      fi; \
    done

# ============================================================================
# Stage 2: Elixir Release Builder
# ============================================================================

FROM cgr.dev/chainguard/elixir:latest AS mix-builder

WORKDIR /build

# Copy Elixir project
COPY elixir/ ./

# Fetch deps and compile release
RUN mix local.hex --force && mix local.rebar --force
ENV MIX_ENV=prod
RUN mix deps.get --only prod
RUN mix compile
RUN mix release boj_rest

# ============================================================================
# Stage 3: Runtime Image
# ============================================================================

FROM cgr.dev/chainguard/wolfi-base:latest

# OCI labels
LABEL org.opencontainers.image.title="Bundle of Joy Server" \
      org.opencontainers.image.description="BoJ REST server — Elixir + Zig FFI cartridge host" \
      org.opencontainers.image.url="https://github.com/hyperpolymath/boj-server" \
      org.opencontainers.image.source="https://github.com/hyperpolymath/boj-server" \
      org.opencontainers.image.vendor="hyperpolymath" \
      org.opencontainers.image.licenses="PMPL-1.0-or-later" \
      org.opencontainers.image.authors="Jonathan D.A. Jewell <j.d.a.jewell@open.ac.uk>" \
      dev.stapeln.compose="container/compose.toml"

# Minimal runtime deps: OpenSSL (Elixir TLS), ncurses (Erlang), glibc (boj-invoke + .so)
RUN apk add --no-cache ca-certificates openssl ncurses-libs libstdc++ gcompat

# Non-root user
RUN addgroup -S appuser && adduser -S appuser -G appuser

WORKDIR /app

# Copy Elixir release (bundles ERTS — no separate Erlang install needed)
COPY --from=mix-builder /build/_build/prod/rel/boj_rest ./

# Copy boj-invoke binary
COPY --from=zig-builder /build/ffi/zig/zig-out/bin/boj-invoke /app/bin/boj-invoke
RUN chmod +x /app/bin/boj-invoke

# Copy cartridge .so files preserving expected layout:
# /app/cartridges/<name>/ffi/zig-out/lib/<lib>.so
RUN mkdir -p /app/cartridges
COPY --from=zig-builder /build/cartridges/ /tmp/cartridges-src/
RUN for cart_dir in /tmp/cartridges-src/*/; do \
      cart="$(basename "$cart_dir")" && \
      so_dir="${cart_dir}ffi/zig-out/lib" && \
      if [ -d "$so_dir" ]; then \
        target="/app/cartridges/${cart}/ffi/zig-out/lib" && \
        mkdir -p "$target" && \
        cp -r "${so_dir}/"*.so "$target/" 2>/dev/null || true; \
      fi; \
    done && \
    rm -rf /tmp/cartridges-src

# Copy cartridge metadata (cartridge.json files — loaded by Catalog GenServer)
RUN mkdir -p /app-cartridges-meta
COPY cartridges/ /tmp/carts-meta/
RUN for cart_dir in /tmp/carts-meta/*/; do \
      cart="$(basename "$cart_dir")" && \
      if [ -f "${cart_dir}cartridge.json" ]; then \
        mkdir -p "/app/cartridges/${cart}" && \
        cp "${cart_dir}cartridge.json" "/app/cartridges/${cart}/"; \
      fi; \
    done && \
    rm -rf /tmp/carts-meta

# Data directory
RUN mkdir -p /data && chown appuser:appuser /data
RUN chown -R appuser:appuser /app

ENV BOJ_CARTRIDGES_ROOT=/app/cartridges
ENV BOJ_INVOKE_CLI=/app/bin/boj-invoke
ENV PHX_HOST=0.0.0.0
ENV PORT=7700
ENV MIX_ENV=prod

VOLUME ["/data"]
USER appuser

EXPOSE 7700

HEALTHCHECK --interval=30s --timeout=5s --start-period=15s --retries=3 \
    CMD /app/bin/boj-invoke /app/cartridges/boj-health/ffi/zig-out/lib/libboj_health.so probe \
      | grep -q '"ok":true' || exit 1

ENTRYPOINT ["/app/bin/boj_rest"]
CMD ["start"]
