# SPDX-License-Identifier: PMPL-1.0-or-later
# Bundle of Joy Server Container Image
#
# Multi-stage build: Zig FFI compilation + V adapter binary (both built
# inside Stage 1 — no local pre-build required).
#
# Build with Podman:
#   podman build -t boj-server:latest -f container/Containerfile .
#
# Run:
#   podman run -p 7700:7700 -p 7701:7701 -p 7702:7702 -p 7703:7703 boj-server:latest
#
# Run with persistent volume:
#   podman run -p 7700:7700 -p 7701:7701 -p 7702:7702 -p 7703:7703 \
#     -v boj-server-data:/data boj-server:latest

# ============================================================================
# Stage 1: FFI Builder
# ============================================================================
#
# Compiles all Zig FFI layers (core + all cartridges) in ReleaseFast mode,
# then compiles the V adapter binary against those FFI libs — fully
# self-contained, no local pre-build required.

FROM cgr.dev/chainguard/wolfi-base:latest AS builder

# Install Zig toolchain, C toolchain, Git (needed to bootstrap V compiler),
# and sqlite dev headers (linked by some cartridge FFIs).
RUN apk add --no-cache build-base zig sqlite-dev git

WORKDIR /build

# Copy source tree
COPY . .

# Build core FFI (catalogue, loader, guardian, federation, readiness, verisimdb, e2e)
RUN cd ffi/zig && zig build -Doptimize=ReleaseFast

# Build ALL cartridge FFI shared libraries (discovers dynamically)
RUN for ffi_dir in /build/cartridges/*/ffi; do \
      cart="$(basename "$(dirname "$ffi_dir")")" && \
      if [ -f "$ffi_dir/build.zig" ]; then \
        echo "Building ${cart} FFI..." && \
        cd "$ffi_dir" && \
        zig build -Doptimize=ReleaseFast || echo "WARN: ${cart} build failed (non-fatal)"; \
      fi; \
    done

# Build V compiler from source (no Wolfi package available).
# V bootstraps via a small vendored C file — gcc compiles it in seconds,
# then V uses itself to finish the full build (~2 min).
RUN git clone --depth 1 https://github.com/vlang/v /tmp/vlang && \
    cd /tmp/vlang && make && \
    cp v /usr/local/bin/v && \
    rm -rf /tmp/vlang

# Compile V adapter binary, linking against all Zig FFI shared libs.
RUN LFLAGS="-L/build/ffi/zig/zig-out/lib" && \
    for d in /build/cartridges/*/ffi/zig-out/lib; do \
      [ -d "$d" ] && LFLAGS="${LFLAGS} -L${d}"; \
    done && \
    v -cc gcc -cflags "${LFLAGS} -Wl,--allow-multiple-definition -no-pie" \
      -o /build/adapter/v/boj-server /build/adapter/v/src/

# ============================================================================
# Stage 2: Runtime
# ============================================================================
#
# Minimal production image. Only the compiled binary, shared libraries,
# and runtime dependencies are included.

FROM cgr.dev/chainguard/wolfi-base:latest

# OCI image labels (compatible with cerro-torre .ctp bundle metadata)
LABEL org.opencontainers.image.title="Bundle of Joy Server" \
      org.opencontainers.image.description="Unified server capability catalogue with formally verified cartridges, distributed community hosting, and the Teranga menu system" \
      org.opencontainers.image.url="https://github.com/hyperpolymath/boj-server" \
      org.opencontainers.image.source="https://github.com/hyperpolymath/boj-server" \
      org.opencontainers.image.vendor="hyperpolymath" \
      org.opencontainers.image.licenses="PMPL-1.0-or-later" \
      org.opencontainers.image.authors="Jonathan D.A. Jewell <j.d.a.jewell@open.ac.uk>" \
      dev.cerrotorre.manifest="container/manifest.toml" \
      dev.cerrotorre.gatekeeper="container/.gatekeeper.yaml" \
      dev.stapeln.compose="container/compose.toml"

# Minimal runtime dependencies
RUN apk add --no-cache ca-certificates curl

# Create non-root user
RUN addgroup -S appuser && adduser -S appuser -G appuser

WORKDIR /app

# Copy V adapter binary compiled in Stage 1
COPY --from=builder /build/adapter/v/boj-server /app/boj-server
RUN chmod +x /app/boj-server

# Copy core FFI libraries from builder stage
COPY --from=builder /build/ffi/zig/zig-out/ /app/lib/core/

# Copy ALL cartridge FFI build outputs from builder stage (single layer)
COPY --from=builder /build/cartridges/ /app/lib/cartridges-src/
# Extract only the zig-out directories (built .so files) — discard source
RUN mkdir -p /app/lib/cartridges && \
    for cart_dir in /app/lib/cartridges-src/*/ffi/zig-out; do \
      cart="$(basename "$(dirname "$(dirname "$cart_dir")")")" && \
      cp -r "$cart_dir" "/app/lib/cartridges/${cart}/" 2>/dev/null || true; \
    done && \
    rm -rf /app/lib/cartridges-src

# Copy entrypoint script
COPY container/entrypoint.sh /app/entrypoint.sh
RUN chmod +x /app/entrypoint.sh

# Copy stapeln integration files
COPY container/.gatekeeper.yaml /etc/svalinn/gatekeeper.yaml
COPY container/manifest.toml /app/manifest.toml

# Copy machine-readable config (menu, order-ticket)
COPY .machine_readable/servers/ /app/config/servers/

# Create data directory for persistent storage
RUN mkdir -p /data && chown appuser:appuser /data

# Set ownership
RUN chown -R appuser:appuser /app

# Environment variables
ENV APP_HOST=[::]
ENV APP_PORT=7700
ENV APP_LOG_FORMAT=json
ENV APP_DATA_DIR=/data
# LD_LIBRARY_PATH is set dynamically in entrypoint.sh to cover all cartridges
ENV LD_LIBRARY_PATH=/app/lib/core/lib

# Persistent storage volume
VOLUME ["/data"]

# Run as non-root
USER appuser

# Expose all four adapter ports (REST, gRPC, GraphQL, MCP/SSE)
EXPOSE 7700 7701 7702 7703

# Health check via REST endpoint
HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
    CMD curl -sf http://localhost:${APP_PORT}/health || exit 1

ENTRYPOINT ["/app/entrypoint.sh"]
CMD ["/app/boj-server"]
