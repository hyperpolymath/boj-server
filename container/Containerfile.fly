#
# BoJ Server — fly.io variant Containerfile
#
# Differences from Containerfile (Chainguard-native):
#   Stage 1: builds boj-invoke only (skip cartridge .so compilation — reduces
#            build time from ~50 min to ~3 min; seed nodes serve JS path for
#            all cartridges until a full image build is triggered separately)
#   Stage 2: elixir:1.16 (official Debian/glibc) — Chainguard Elixir requires
#            auth unavailable on fly.io's Depot remote builder
#   Stage 3: wolfi-base packages corrected for wolfi APK index (glibc-native,
#            no gcompat; ncurses not ncurses-libs); HEALTHCHECK uses HTTP
#            (curl /health) rather than boj-invoke so no .so file is required
#
# Deploy: fly deploy --dockerfile container/Containerfile.fly ...  (from repo root)

# ============================================================================
# Stage 1: Zig FFI Builder (boj-invoke only)
# ============================================================================

FROM cgr.dev/chainguard/wolfi-base:latest AS zig-builder

RUN apk add --no-cache zig build-base

WORKDIR /build

COPY ffi/zig/ ffi/zig/

# Build only the boj-invoke dispatch CLI — skip cartridge .so compilation.
# Seed nodes primarily serve federation/gossip; cartridge FFI can be added
# in a dedicated image build (see container/Containerfile for full build).
RUN cd ffi/zig && zig build invoke -Doptimize=ReleaseFast

# ============================================================================
# Stage 2: Elixir Release Builder
# Official elixir image (Debian glibc) — no auth required, matches Stage 3 ABI
# ============================================================================

FROM elixir:1.16 AS mix-builder

WORKDIR /build

COPY elixir/ ./

RUN mix local.hex --force && mix local.rebar --force
ENV MIX_ENV=prod
RUN mix deps.get --only prod
RUN mix compile
RUN mix release boj_rest

# ============================================================================
# Stage 3: Runtime Image (wolfi-base — glibc, matches elixir:1.16 ABI)
# ============================================================================

FROM cgr.dev/chainguard/wolfi-base:latest

LABEL org.opencontainers.image.title="Bundle of Joy Server" \
      org.opencontainers.image.description="BoJ REST server — Elixir + Zig FFI cartridge host (fly.io seed)" \
      org.opencontainers.image.url="https://github.com/hyperpolymath/boj-server" \
      org.opencontainers.image.source="https://github.com/hyperpolymath/boj-server" \
      org.opencontainers.image.vendor="hyperpolymath" \
      org.opencontainers.image.licenses="MPL-2.0" \
      org.opencontainers.image.authors="Jonathan D.A. Jewell <j.d.a.jewell@open.ac.uk>"

# wolfi is glibc-native: no gcompat; ncurses not ncurses-libs; add curl for healthcheck
RUN apk add --no-cache ca-certificates openssl ncurses libstdc++ libssl3 curl

RUN addgroup -S appuser && adduser -S appuser -G appuser

WORKDIR /app

COPY --from=mix-builder /build/_build/prod/rel/boj_rest ./

COPY --from=zig-builder /build/ffi/zig/zig-out/bin/boj-invoke /app/bin/boj-invoke
RUN chmod +x /app/bin/boj-invoke

# Copy cartridge metadata (cartridge.json) — no .so files in this seed image
RUN mkdir -p /app/cartridges
COPY cartridges/ /tmp/carts-meta/
RUN for cart_dir in /tmp/carts-meta/*/; do \
      cart="$(basename "$cart_dir")" && \
      if [ -f "${cart_dir}cartridge.json" ]; then \
        mkdir -p "/app/cartridges/${cart}" && \
        cp "${cart_dir}cartridge.json" "/app/cartridges/${cart}/"; \
      fi; \
    done && \
    rm -rf /tmp/carts-meta

RUN mkdir -p /data && chown appuser:appuser /data
RUN chown -R appuser:appuser /app

ENV BOJ_CARTRIDGES_ROOT=/app/cartridges
ENV BOJ_INVOKE_CLI=/app/bin/boj-invoke
ENV PHX_HOST=0.0.0.0
ENV PORT=7700
ENV MIX_ENV=prod

VOLUME ["/data"]
USER appuser

EXPOSE 7700

# Health check via HTTP endpoint (no .so dependency)
HEALTHCHECK --interval=30s --timeout=10s --start-period=30s --retries=3 \
    CMD curl -sf http://localhost:7700/health | grep -q ok || exit 1

ENTRYPOINT ["/app/bin/boj_rest"]
CMD ["start"]
