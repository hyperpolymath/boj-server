{
  "$schema": "https://gossamer.dev/schemas/config/v1",
  "productName": "BoJ Node",
  "version": "0.2.0",
  "identifier": "dev.hyperpolymath.boj-node",
  "build": {
    "frontendDist": "./src",
    "devUrl": "http://localhost:1420"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "BoJ Node Operator",
        "width": 520,
        "height": 640,
        "minWidth": null,
        "minHeight": null,
        "maxWidth": null,
        "maxHeight": null,
        "resizable": true,
        "fullscreen": false,
        "decorations": true,
        "transparent": false,
        "center": true,
        "alwaysOnTop": false,
        "visible": false,
        "url": "/"
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' http://localhost:7700",
      "capabilities": [
        "network",
        "shell",
        "tray",
        "notification"
      ],
      "capabilityTokens": {
        "enabled": false,
        "issuer": "gossamer-runtime",
        "ttl": 3600
      },
      "sandbox": {
        "enabled": true,
        "allowExec": false,
        "allowNetwork": true,
        "allowFilesystem": false
      }
    },
    "ipc": {
      "protocol": "json",
      "bridgeInjection": true,
      "maxMessageSize": 16777216,
      "timeout": 30000
    },
    "tray": {
      "enabled": true,
      "icon": "icons/tray-icon.png",
      "tooltip": "BoJ Server \u2014 Node Operator",
      "menuOnLeftClick": true
    }
  },
  "plugins": {},
  "bundle": {
    "active": true,
    "targets": [
      "deb",
      "appimage",
      "dmg",
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.png"
    ],
    "resources": [],
    "copyright": "Copyright (c) 2026 Jonathan D.A. Jewell (hyperpolymath)",
    "license": "MPL-2.0",
    "shortDescription": "BoJ node operator tray application",
    "longDescription": "",
    "linux": {
      "desktopEntry": true,
      "category": "Utility",
      "section": "utils",
      "depends": [],
      "appimage": {
        "bundleMediaFramework": false
      }
    },
    "macos": {
      "bundleIdentifier": "dev.hyperpolymath.boj-node",
      "minimumSystemVersion": "11.0",
      "frameworks": [],
      "entitlements": null,
      "signingIdentity": null,
      "notarization": {
        "enabled": false,
        "teamId": null
      }
    },
    "windows": {
      "webview2": "embed",
      "certificateThumbprint": null,
      "wix": {
        "language": "en-US"
      },
      "nsis": {
        "displayLanguageSelector": false,
        "installerIcon": null
      }
    }
  },
  "ephapax": {
    "modules": [],
    "region": "app",
    "linearVerification": true,
    "regionBoundary": "strict",
    "preload": []
  }
}
