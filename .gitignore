# RSR-compliant .gitignore

# OS & Editor
.DS_Store
Thumbs.db
*.swp
*.swo
*~
.idea/
.vscode/
.direnv/

# Build
/target/
/_build/
/build/
/dist/
/out/

# Dependencies
/node_modules/
/vendor/
/deps/
/.elixir_ls/

# Rust
# Cargo.lock  # Keep for binaries

# Elixir
/cover/
/doc/
*.ez
erl_crash.dump

# Julia
*.jl.cov
*.jl.mem
/Manifest.toml

# ReScript
/lib/bs/
/.bsb.lock

# Python (SaltStack only)
__pycache__/
*.py[cod]
.venv/

# Ada/SPARK
*.ali
/obj/
/bin/

# Nix
# flake.lock is tracked in derived projects for reproducible builds.
# flake.lock

# Haskell
/.stack-work/
/dist-newstyle/

# Chapel
*.chpl.tmp.*

# Secrets
.env
.env.*
!.env.example
*.pem
*.key
secrets/

# Test/Coverage
/coverage/
htmlcov/

# Logs
*.log
/logs/

# Maintenance local artifacts
.maintenance-perms-state.tsv
reports/maintenance/*.json

# Temp
/tmp/
*.tmp
*.bak

# Crash recovery artifacts
ai-cli-crash-capture/

# KDE metadata
.directory

# Sync artifacts
sync_report*.txt

# Idris2 build artifacts
src/abi/build/

# Zig build artifacts (all locations — matches nested dirs too)
**/.zig-cache/
**/zig-out/

# Nickel validator temp files — written to schemas/ for relative import,
# deleted on normal exit; leftovers only appear on crash. Defensive.
**/._validate_*.ncl
**/_test_case_*.ncl

# Cartridge Idris2 build artifacts
cartridges/*/abi/build/

# Hypatia scanner logs
.hypatia/

# SQLite database files (created during testing/use)
*.sqlite
*.sqlite3
*.db

# VeriSimDB local data
.verisimdb/

# Shared library build outputs (cartridge .so files)
*.so
*.dylib

# Cartridge minter build artifacts
tools/cartridge-minter/target/

# panic-attack scan reports
panic-attack-report*.json
/json

# asdf version manager — tracked in this repo to pin reproducible
# toolchain versions (zig 0.15.1 not 0.16.0; elixir 1.18+ not apt's 1.14;
# etc.). asdf reads .tool-versions on `cd` into the repo and automatically
# uses the pinned versions.

# wokelangiser generated i18n locale files (too large for GitHub)
generated/wokelangiser/i18n/
target/
node_modules/
_build/
deps/
.elixir_ls/
.cache/
build/
dist/

# generated/* — produced by boj-server -mcp cartridges on push via *-regen.yml.
# DO NOT commit these. If missing locally, trigger regeneration:
#   curl -X POST http://boj-server.local:7700/cartridges/k9iser-mcp/invoke \
#     -d '{"repo": "hyperpolymath/<repo>", "tool": "k9_generate"}'
# Standards#93 / #89 sub-issue 1+2 must be wired before this line is safe.
generated/k9iser/
generated/tlaiser/
generated/wokelangiser/
generated/alloyiser/
generated/abi/

# Superpowers docs and artefacts (local only)
docs/superpowers/
.superpowers/
