# STATE.a2ml — Project state checkpoint for Bundle of Joy Server

[metadata]
project = "boj-server"
version = "1.1.0-wip"
last-updated = "2026-04-25"
status = "active"
grade = "C"

[project-context]
name = "Bundle of Joy Server"
purpose = "Unified server capability catalogue. AI goes to ONE place instead of hunting across dozens of MCP servers. Distributed via community-hosted Umoja nodes with gossip protocol and hash attestation. 112 cartridges covering the full developer-tool matrix."
completion-percentage = 65

[stack]
# Current authoritative stack — V-lang adapter layer is GONE (banned 2026-04-10, removed 2026-04-12)
abi-layer    = "Idris2 — formal interface definitions with dependent-type proofs"
ffi-layer    = "Zig    — C-ABI .so shared libraries (boj-invoke CLI for dlopen dispatch)"
rest-server  = "Elixir (Plug/Cowboy) — HTTP surface on port 7700, 5 routes"
js-dispatch  = "Deno   — mod.js cartridges dispatched via BojRest.JsWorkerPool (persistent pool, consistent-hash routing) with JsInvoker fork-per-call fallback"
container    = "Chainguard wolfi-base (Containerfile, 3-stage Zig+Elixir build)"
federation   = "Zig QUIC gossip (X25519 + ChaCha20-Poly1305, UDP 9999)"

[route-to-mvp]
milestones = [
  { name = "Phase 0: Fresh repo from rsr-template-repo", completion = 100 },
  { name = "Phase 1: Core catalogue & menu system (Idris2 ABI)", completion = 100 },
  { name = "Phase 2: Core Zig FFI layer (catalogue + loader)", completion = 100 },
  { name = "Phase 3: V-lang adapter layer", completion = 100, note = "RETIRED — V-lang banned 2026-04-10, all .v files removed 2026-04-12" },
  { name = "Phase 4: First cartridges — boj-health Zig FFI reference impl", completion = 100 },
  { name = "Phase 5: Umoja federation & PanLL panel", completion = 100 },
  { name = "Phase 6: 112-cartridge matrix (all have cartridge.json + mod.js)", completion = 100 },
  { name = "Phase 7: Elixir REST server wired to Zig FFI + JsWorkerPool (persistent Deno pool)", completion = 100 },
  { name = "Phase 8: Gateway sidecar (http-capability-gateway catalog mode + compose.dev.yaml)", completion = 100 },
  { name = "Phase 9: Auth layer (HTTP invoke caller auth, trust-level forwarding, credential proxy)", completion = 0 },
  { name = "Phase 10: Grade D→C (QUIC multi-node, SLA, seed nodes, external validation)", completion = 30 },
]

[quality]
cartridges-total            = 112   # all 112 have cartridge.json + mod.js as of 2026-04-25
cartridges-with-zig-ffi     = 111   # all cartridges with ffi key + compiled .so (model-router-mcp intentionally excluded)
cartridges-with-js-mod      = 111   # mod.js dispatch via Deno worker pool (model-router-mcp is canonical JS-only)
cartridges-with-both        = 0     # no cartridge uses both paths
exunit-tests                = 173   # 10 properties + 163 regular tests across 11 files; Phase 9 auth tests added 2026-04-25
zig-ffi-chain-verified      = true  # boj-invoke → dlopen → libboj_health.so end-to-end tested 2026-04-25
js-dispatch-chain-verified  = true  # JsWorkerPool → JsWorker → Deno port → mod.js handleTool
believe-me-count            = 4     # 3 axiomatic primitives + 1 logSafeBounded — reduced from 31 on 2026-04-12
v-lang-files                = 0     # all .v files removed 2026-04-12

[open-gaps]
# Ordered by impact on users hitting POST /cartridge/:name/invoke
gap-1 = "PARTIALLY CLOSED 2026-04-25 — X-Trust-Level enforcement implemented (BojRest.TrustPolicy); keyed cartridges require authenticated/internal trust from non-loopback callers. Credential forwarding (Options A/B/C) still undecided."
gap-2 = "CLOSED for Options A+B 2026-04-25 — Option A (caller-supplied encrypted creds in request body) wired: CredentialDecryptor.extract/2 → dispatch → Invoker extra_env → subprocess env vars. Option B (node-level env vars) inherits from server process. Option C (RGTV broker) remains future work."
gap-3 = "Load-aware inter-node routing not wired — invocations are local only"
gap-5 = "CLOSED 2026-04-25 — All 4 fly.io seed nodes deployed and healthy (2/2 health checks passing): boj-seed-eu (lhr), boj-seed-de (fra), boj-seed-us (iad), boj-seed-ap (syd). Image 61 MB. .dockerignore fixed (ffi/zig/.zig-cache excluded — 347 MB); Containerfile.fly.dockerignore added for per-Dockerfile override (2.2 MB context for future deploys). DNS: hyperpolymath.dev still undelegated — .fly.dev hostnames operative."
gap-4 = "CLOSED 2026-04-25 — Test coverage reached CRG C (165 tests: 10 properties + 155 regular, 0 failures)"

[critical-next-actions]
actions = [
  "Expand test suite DONE — 165 tests at CRG C as of 2026-04-25",
  "Decide and implement HTTP invoke auth (see docs/AUTH-DESIGN.adoc — options: bearer token, mTLS header, or node-identity header)",
  "Implement credential-forwarding design for federation (user keys travel with the request encrypted, vs node-level key config)",
  "DONE — All 4 fly.io seed nodes deployed and healthy 2026-04-25 (lhr/fra/iad/syd). Registrar action still needed to delegate hyperpolymath.dev zone (see container/fly/DNS-SETUP.adoc).",
]

[blockers-and-issues]
invoke-auth = "OPEN — HTTP invoke endpoint has no caller auth (see docs/AUTH-DESIGN.adoc)"
credential-forwarding = "OPEN — design not yet decided; critical for federation use case"
test-coverage = "CLOSED 2026-04-25 — 165 ExUnit tests; CRG C met"

[session-history]
entries = [
  { date = "2026-04-25", description = "Documentation + deploy sweep session: (1) .dockerignore fixed — ffi/zig/.zig-cache/ (347 MB) + ffi/zig/zig-out/ + cartridges/*/ffi/.zig-cache/ added; reduces build context from ~2.8 GB to ~2.2 MB for fly seed deploys. (2) Containerfile.fly.dockerignore created at repo root (Docker BuildKit per-Dockerfile override) — also excludes cartridges/*/ffi/ + abi/ + adapter/ + panels/ (cartridge source not needed in seed builds). (3) 6a2 sweep: AGENTIC (fly.io pitfall constraints + v0.2.0); ECOSYSTEM (seed-nodes updated with fly.io apps/hosts/regions + dns-status + federation protocol corrected + V-lang ref fixed + v0.2.0); NEUROSYM (report-format logtalk→json + v0.2.0); PLAYBOOK (full operational runbook: local dev, full container, fly.io per-node + deploy-seeds.sh, notes on glibc/musl ABI, .dockerignore, custom domain procedure + v0.2.0); META (languages elixir+javascript added, ADR-010 through ADR-014, design-rationale seed-node-lean-build + trust-level-design + v0.3.0). (4) All 4 fly.io seed nodes still pending — prior EU build stalled at 2.8 GB upload. Redeploying with corrected dockerignore." },
  { date = "2026-04-25", description = "MCP install session: Added local-coord-mcp to Claude Code global settings (~/.claude/settings.json). Entry runs mcp-bridge/main.js (node) with BOJ_URL=http://localhost:7700 + COORD_BACKEND_URL=http://127.0.0.1:7745. Backend (local_coord_ada, port 7745) and BoJ server (beam.smp, port 7700) were already running. Smoke-tested coord_register end-to-end through bridge — returned valid peer_id + token. No boj-server code changed; settings change takes effect on Claude Code restart or /hooks reload." },
  { date = "2026-04-25", description = "coord-tui + maintenance sweep session: (1) ROOT-CAUSE: local-coord-mcp adapter was never started on port 7745. mcp-bridge fully wired, Elixir catalog had cartridge at boot, but no process was listening. Fixed: built cartridges/local-coord-mcp/adapter/ and created ~/.config/systemd/user/local-coord-mcp.service (enabled + started). (2) MAINTENANCE: catalogue.zig — code_intel=18 missing from CapabilityDomain enum (Domain.idr had 18 domains, Zig stopped at bsp=17; C-ABI gap); added code_intel=18, fixed comment '1-13'→'1-18'. Check.idr — SPDX header added. tests/mcp_bench.zig — deserialisation bench upper-bound 5_000→10_000ms (debug builds parse ~0.8ms/req; old bound was too tight for CI). (3) coord-tui (new, coord-tui/ directory): Rust TUI using ratatui+crossterm+ureq+clap. Interactive mode: two-panel view (Peers top/Claims bottom), TableState keyboard nav [j/k/Tab/c/s/p/R/q], claim+status input overlay, 5s auto-refresh. --id silent mode: registers, writes ~/.cache/coord-tui/peer.env (BOJ_COORD_PEER_ID + BOJ_COORD_TOKEN), prints peer_id, exits immediately — no TUI. Pure state helpers (next_index/prev_index/clamp_selection) isolated for future SPARK/Ada verification. (4) Shell hooks (coord-tui/shell/coord-hooks.sh): wraps claude/gemini/cursor/codex — calls coord-tui --id --kind <k>, sources peer.env, sets terminal window title to '<tool> [<peer_id>]' via ANSI escape for multi-instance identification. Sourced from ~/.bashrc + ~/.zshrc. (5) Installer (coord-tui/install.sh): checks cargo+zig, builds Zig adapter + Rust coord-tui, symlinks to ~/.local/bin, installs systemd service, copies hooks to ~/.config/coord-tui/, patches shell rcs. Human docs: coord-tui/EXPLAINME.adoc + coord-tui/README.adoc. Commits: 0837968 (maintenance), e07aee5 (coord-tui + hooks + installer + docs)." },
  { date = "2026-04-25", description = "Seed node deployment session: (1) 4 fly.io apps created (boj-seed-eu/de/us/ap) in regions lhr/fra/iad/syd. (2) 1 GB persistent volumes per app. (3) Containerfile.fly created — swaps cgr.dev/chainguard/elixir (auth-gated) for elixir:1.16 (public Debian/glibc) in Stage 2; wolfi-base package names corrected in Stage 3. (4) .dockerignore added to reduce build context upload (~500 MB → <<100 MB future). (5) container/fly/ directory: fly-eu/de/us/ap.toml + deploy-seeds.sh. (6) seed-nodes.toml v0.2.0: operative .fly.dev hostnames; canonical hyperpolymath.dev aliases noted as pending DNS delegation. (7) compose.prod.yaml BOJ_SEED_NODES updated to fly.dev. (8) QUICKSTART-USER.adoc seed node list updated. Deployment of EU node in progress." },
  { date = "2026-04-25", description = "Items 1+2+3 session: (1) Credential forwarding gaps A+B closed — chain fully wired (CredentialDecryptor → dispatch → Invoker extra_env → subprocess env vars). Option C (RGTV) future work. (2) tools/cartridge-minter/ DELETED — Node.js banned artefact. Justfile, QUICKSTART-USER.adoc, llm-warmup-dev.md, llm-warmup-user.md updated to reference launch-scaffolder. (3) Seed node infra: compose.prod.yaml created (production Podman Compose using ghcr.io image, all 4 seed peers pre-wired); QUICKSTART-USER.adoc seed node section added; container-publish.yml label updated 99→112 cartridges. container/boj-community-node.container + seed-nodes.toml already existed." },
