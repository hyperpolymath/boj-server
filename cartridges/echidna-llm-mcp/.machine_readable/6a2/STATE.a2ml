# STATE.a2ml — echidna-llm-mcp cartridge state

[metadata]
project = "echidna-llm-mcp"
version = "0.3.0"
last-updated = "2026-04-25"
status = "active"

[project-context]
name = "echidna-llm-mcp"
purpose = """
BoJ cartridge exposing echidna's proof engine to AI assistants via
JSON-RPC. 15 tools mapping 1:1 to echidna REST endpoints, addressable
across all 113 ProverKind variants by slug.
"""
completion-percentage = 90

[position]
phase = "production"
maturity = "stable"

# ═══════════════════════════════════════════════════════════════════════════════
# CRG (Critical Reception Grade) advancement — D→C→B
# Per memory rule: B-grade requires [external-targets]≥6, [issues-fed-back],
# [field-signal] populated.
# ═══════════════════════════════════════════════════════════════════════════════

[external-targets]
# Consumers found via grep across hyperpolymath estate (2026-04-24 audit).
