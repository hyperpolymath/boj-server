relationship = "consumer"
contract = "References cartridge as canonical ECHIDNA invocation surface"
discovered = "estate-wide cartridge consumer audit 2026-04-24"

[[external-targets.target]]
name = "panll"
relationship = "consumer"
contract = "Same — uses cartridge for proof operations"
discovered = "estate-wide cartridge consumer audit 2026-04-24"

[[external-targets.target]]
name = "007-lang"
relationship = "consumer"
contract = "Cartridge invocation for proof verification"
discovered = "estate-wide cartridge consumer audit 2026-04-24"

[[external-targets.target]]
name = "proven-servers"
relationship = "consumer"
contract = "Cartridge invocation alongside its own direct REST path to echidna-nesy"
discovered = "estate-wide cartridge consumer audit 2026-04-24"

[[external-targets.target]]
name = "typell"
relationship = "consumer"
contract = "Type-system-driven proof queries through cartridge"
discovered = "estate-wide cartridge consumer audit 2026-04-24"

[[external-targets.target]]
name = "nesy-solver"
relationship = "consumer"
contract = "Neurosymbolic solving via cartridge tool surface"
discovered = "estate-wide cartridge consumer audit 2026-04-24"

[[external-targets.target]]
name = "absolute-zero"
relationship = "consumer"
contract = "Cartridge invocation for proof operations"
discovered = "estate-wide cartridge consumer audit 2026-04-24"

[[external-targets.target]]
name = "boj-server (parent — TOPOLOGY.md)"
relationship = "hosted-in-and-referenced-by"
contract = "Cartridge listed in boj-server TOPOLOGY.md as a documented loader target"
discovered = "boj-server/TOPOLOGY.md cross-reference"

[[external-targets.target]]
name = "echidna (upstream)"
relationship = "delegated-to"
contract = "All proof operations route through to echidna's REST endpoints; cartridge does no local proof work"
discovered = "ECOSYSTEM.a2ml + docs/CALL-PROTOCOL.adoc"

[issues-fed-back]
[[issues-fed-back.issue]]
source = "V-lang ban 2026-04-10"
date = "2026-04-10"
issue = "V-lang adapter at adapter/v/ deleted estate-wide; cartridge needed Zig replacement to retain native path"
status = "resolved — Zig adapter at adapter/ ships; commits 1fef110 + c5188a8 swept V-lang refs from docs"

[[issues-fed-back.issue]]
source = "audit 2026-04-25 — Zig 0.15.2 build"
date = "2026-04-25"
issue = "adapter/build.zig used Zig 0.14 ExecutableOptions API (.root_source_file); cartridge couldn't build on stable Zig 0.15.2"
status = "resolved — commit afbab20 (4 sub-issues: API drift, libc, 16 pub fns, missing init arg)"

[[issues-fed-back.issue]]
source = "RSR conformance audit 2026-04-25"
date = "2026-04-25"
issue = "Cartridge missing LICENSE/SECURITY.md/CONTRIBUTING.md/EXPLAINME.adoc + .machine_readable/6a2/ scaffold"
status = "resolved — commit c4846e6 (11 new files including this CRG block)"

[[issues-fed-back.issue]]
source = "panic-attack P10 sweep 2026-04 (parent boj-server)"
date = "2026-04"
issue = "FFI ptrCast classification + adapter header V-lang reference"
status = "resolved — commits 55de256 (ptrCast classify), 1fef110 + c5188a8 (V-lang seam sweep)"

